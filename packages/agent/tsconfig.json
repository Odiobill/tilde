{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../config"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../credentials"
    },
    {
      "path": "../transport"
    },
    {
      "path": "../tools"
    }
  ]
}
