{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/credentials"
    },
    {
      "path": "../../packages/transport"
    },
    {
      "path": "../../packages/agent"
    }
  ]
}
